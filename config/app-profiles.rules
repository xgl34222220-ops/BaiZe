standard|ext|com.tencent.mobileqq|Tencent/MobileQQ/qbosssplahAD|0
enhanced|ext|com.tencent.mobileqq|Tencent/MobileQQ/.apollo|7
enhanced|ext|com.tencent.mobileqq|cache|0
enhanced-media|ext|com.tencent.mobileqq|Tencent/MobileQQ/chatpic|30
enhanced-media|ext|com.tencent.mobileqq|Tencent/MobileQQ/shortvideo|30

