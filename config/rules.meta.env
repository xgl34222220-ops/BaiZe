rules_format=baize-rules-v3
rules_version=2026.07.21
rules_count=4714
rules_sha256=eafb6068fa68f367b5bddccbdc1fbe9cac0156e8d2f6759ee8cb130a375961ed
default_risk=review
scheduled_allowed_risk=safe
high_risk_policy=scan-only

# 风险判定方式：
#   explicit  规则行的 "路径|risk" 标注，用户覆盖文件优先级最高
#   segment   按完整路径分段匹配关键词推断
# 历史实现用 strstr 在整条路径上找子串，会把 /nfc/logo、/login-identifier
# 这类用户数据误判为 low 并被定时任务自动删除，现已改为分段匹配。
risk_resolution=explicit-then-segment
risk_overrides_file=risk-overrides.conf
