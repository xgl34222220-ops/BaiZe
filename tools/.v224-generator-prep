from pathlib import Path

path = Path(__file__).resolve().parents[1] / "tools/apply-v224-background-recovery.py"
text = path.read_text()
text = text.replace(
    "    if new in text:\n        return\n    if old not in text:\n        raise SystemExit(f\"missing activity anchor: {old[:140]!r}\")",
    "    if old not in text:\n        if new in text:\n            return\n        raise SystemExit(f\"missing activity anchor: {old[:140]!r}\")"
)
text = text.replace(r'append("\n")', r'append("\\n")')
text = text.replace(r'append("\n正在停止…")', r'append("\\n正在停止…")')
text = text.replace(r'append("\n可切到后台，Root 会继续执行")', r'append("\\n可切到后台，Root 会继续执行")')
path.write_text(text)
print("v2.2.4 generator escapes and repeated anchors prepared")
