<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#EE1C2632"
                android:centerColor="#E6263342"
                android:endColor="#EE18212C" />
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp" />
        </shape>
    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
