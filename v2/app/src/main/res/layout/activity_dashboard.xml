<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app_gradient">

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="104dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_category_blue"
                        android:text="泽"
                        android:textColor="@color/baize_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="白泽"
                            android:textColor="@color/baize_text_primary"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="轻量、自动、可审计的系统清理"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/versionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_version_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Alpha 6"
                        android:textColor="@color/baize_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/baize_surface_high">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="存储概览"
                                    android:textColor="@color/baize_text_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/freeSpaceText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="--"
                                    android:textColor="@color/baize_text_primary"
                                    android:textSize="27sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/storageDetailText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="正在读取存储状态"
                                    android:textColor="@color/baize_text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/storageRing"
                                android:layout_width="82dp"
                                android:layout_height="82dp"
                                android:indeterminate="false"
                                app:indicatorColor="@color/baize_primary"
                                app:indicatorSize="76dp"
                                app:trackColor="#24FFFFFF"
                                app:trackThickness="7dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cleanNowButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1.65"
                        android:text="立即清理"
                        android:textSize="15sp"
                        app:backgroundTint="@color/baize_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanOnlyButton"
                        style="@style/Widget.BaiZe.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="仅扫描"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopTaskButton"
                    style="@style/Widget.BaiZe.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="停止当前任务"
                    android:textColor="@color/baize_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/serviceDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/serviceStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="正在连接 Root 服务"
                        android:textColor="@color/baize_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/lastFreedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最近释放 --"
                        android:textColor="@color/baize_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="专项工具"
                    android:textAppearance="@style/TextAppearance.BaiZe.SectionTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/advancedAuditButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:gravity="start|center_vertical"
                            android:text="高级审计     查看缓存、空项目、规则与碎片明细"
                            android:textColor="@color/baize_text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/corpsesToolButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:gravity="start|center_vertical"
                            android:text="卸载残留     扫描 Android/data 与 Android/obb"
                            android:textColor="@color/baize_text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/deepToolButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:gravity="start|center_vertical"
                            android:text="深度规则     4,746 条规则分级扫描与授权清理"
                            android:textColor="@color/baize_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="运行概览"
                    android:textAppearance="@style/TextAppearance.BaiZe.SectionTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/taskStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="等待清理任务"
                            android:textColor="@color/baize_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/recentTaskText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="暂无清理记录"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_status_dot" />

                        <TextView
                            android:id="@+id/schedulerStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="正在读取自动清理状态"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/planPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="104dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动清理"
                    android:textAppearance="@style/TextAppearance.BaiZe.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="设置会写入 Root 配置，由模块后台调度器真实执行"
                    android:textColor="@color/baize_text_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/scheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="启用后台自动清理"
                            android:textColor="@color/baize_text_primary" />

                        <TextView
                            android:id="@+id/intervalText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="每 24 小时"
                            android:textColor="@color/baize_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/intervalSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="24"
                            android:stepSize="1"
                            android:valueFrom="1"
                            android:valueTo="720" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/dailySwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="改为每日固定时间"
                            android:textColor="@color/baize_text_primary" />

                        <TextView
                            android:id="@+id/dailyHourText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="每日 03:00"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/dailyHourSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="3"
                            android:stepSize="1"
                            android:valueFrom="0"
                            android:valueTo="23" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="定时任务组"
                    android:textAppearance="@style/TextAppearance.BaiZe.SectionTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/cacheScheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="应用缓存"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/emptyScheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="空文件与空目录"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/rulesScheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="规则垃圾与日志"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/fragmentScheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="残留碎片"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/deepScheduleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="深度安全项（仅低/中风险）"
                            android:textColor="@color/baize_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="执行条件"
                    android:textAppearance="@style/TextAppearance.BaiZe.SectionTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/screenOffSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="仅息屏执行"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/chargingSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="仅充电执行"
                            android:textColor="@color/baize_text_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/deviceIdleSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="仅系统空闲执行"
                            android:textColor="@color/baize_text_primary" />

                        <TextView
                            android:id="@+id/minBatteryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="最低电量 25%"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/minBatterySlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="25"
                            android:stepSize="5"
                            android:valueFrom="0"
                            android:valueTo="100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/planStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="正在读取模块计划"
                    android:textColor="@color/baize_text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/savePlanButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="保存并启用模块计划" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/recordsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="104dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记录"
                    android:textAppearance="@style/TextAppearance.BaiZe.PageTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="最近手动任务"
                            android:textColor="@color/baize_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/recordSummaryText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="暂无清理记录"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:id="@+id/recordSchedulerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="正在读取定时任务状态"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshRecordsButton"
                    style="@style/Widget.BaiZe.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="刷新状态" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="104dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textAppearance="@style/TextAppearance.BaiZe.PageTitle" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BaiZe.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/settingsStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="正在连接 Root 服务"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/whitelistText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="白名单：0 个应用"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/notificationSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="任务完成通知"
                            android:textColor="@color/baize_text_primary" />

                        <TextView
                            android:id="@+id/largeFileText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="单文件上限 256 MB"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/largeFileSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="256"
                            android:stepSize="16"
                            android:valueFrom="16"
                            android:valueTo="2048" />

                        <TextView
                            android:id="@+id/fragmentDaysText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="碎片至少保留 7 天"
                            android:textColor="@color/baize_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/fragmentDaysSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="7"
                            android:stepSize="1"
                            android:valueFrom="1"
                            android:valueTo="30" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reconnectButton"
                    style="@style/Widget.BaiZe.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="重新连接 Root 服务" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
</FrameLayout>
