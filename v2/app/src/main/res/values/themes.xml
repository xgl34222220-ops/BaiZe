<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BaiZe" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/baize_primary</item>
        <item name="colorOnPrimary">#171A2B</item>
        <item name="colorPrimaryContainer">@color/baize_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/baize_text_primary</item>
        <item name="colorSecondary">@color/baize_secondary</item>
        <item name="colorSurface">@color/baize_surface</item>
        <item name="colorSurfaceVariant">@color/baize_surface_high</item>
        <item name="colorOnSurface">@color/baize_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/baize_text_secondary</item>
        <item name="android:windowBackground">@color/baize_background</item>
        <item name="android:statusBarColor">@color/baize_background</item>
        <item name="android:navigationBarColor">@color/baize_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialCardViewStyle">@style/Widget.BaiZe.GlassCard</item>
        <item name="materialButtonStyle">@style/Widget.BaiZe.Button</item>
    </style>

    <style name="Widget.BaiZe.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/baize_glass</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/baize_glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BaiZe.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BaiZe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/baize_glass_stroke</item>
    </style>

    <style name="TextAppearance.BaiZe.PageTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/baize_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.BaiZe.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/baize_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
