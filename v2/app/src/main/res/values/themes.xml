<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BaiZe.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorOnPrimary">#07111B</item>
        <item name="colorOnPrimaryContainer">#F5F9FF</item>
        <item name="colorOnSecondary">#061411</item>
        <item name="colorOnSecondaryContainer">#F2FFFC</item>
        <item name="colorError">#FF7F88</item>
        <item name="colorOnError">#210005</item>
        <item name="colorOnSurface">#F5F8FD</item>
        <item name="colorOnSurfaceVariant">#AAB8CC</item>
        <item name="colorOutline">#64748A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/Widget.BaiZe.GlassCard</item>
        <item name="materialButtonStyle">@style/Widget.BaiZe.Button</item>
    </style>

    <style name="Theme.BaiZe" parent="Theme.BaiZe.Blue" />

    <style name="Theme.BaiZe.Blue" parent="Theme.BaiZe.Base">
        <item name="colorPrimary">#58A9FF</item>
        <item name="colorPrimaryContainer">#173B5F</item>
        <item name="colorSecondary">#53D4C6</item>
        <item name="colorSecondaryContainer">#153F3A</item>
        <item name="colorTertiary">#9B8CFF</item>
        <item name="colorSurface">#0B1321</item>
        <item name="colorSurfaceVariant">#172438</item>
        <item name="android:windowBackground">#07101E</item>
        <item name="android:statusBarColor">#07101E</item>
        <item name="android:navigationBarColor">#07101E</item>
    </style>

    <style name="Theme.BaiZe.Aurora" parent="Theme.BaiZe.Base">
        <item name="colorPrimary">#9B8CFF</item>
        <item name="colorPrimaryContainer">#33255F</item>
        <item name="colorSecondary">#59C9FF</item>
        <item name="colorSecondaryContainer">#153A52</item>
        <item name="colorTertiary">#E18DFF</item>
        <item name="colorSurface">#120F1D</item>
        <item name="colorSurfaceVariant">#241C37</item>
        <item name="android:windowBackground">#0B0913</item>
        <item name="android:statusBarColor">#0B0913</item>
        <item name="android:navigationBarColor">#0B0913</item>
    </style>

    <style name="Theme.BaiZe.Jade" parent="Theme.BaiZe.Base">
        <item name="colorPrimary">#4ED7B6</item>
        <item name="colorPrimaryContainer">#123E37</item>
        <item name="colorSecondary">#65B7FF</item>
        <item name="colorSecondaryContainer">#163852</item>
        <item name="colorTertiary">#A2D86B</item>
        <item name="colorSurface">#0A1715</item>
        <item name="colorSurfaceVariant">#162A27</item>
        <item name="android:windowBackground">#06100F</item>
        <item name="android:statusBarColor">#06100F</item>
        <item name="android:navigationBarColor">#06100F</item>
    </style>

    <style name="Theme.BaiZe.Sunset" parent="Theme.BaiZe.Base">
        <item name="colorPrimary">#FFAD63</item>
        <item name="colorPrimaryContainer">#593217</item>
        <item name="colorSecondary">#FFD166</item>
        <item name="colorSecondaryContainer">#4A3A11</item>
        <item name="colorTertiary">#FF8496</item>
        <item name="colorSurface">#19120D</item>
        <item name="colorSurfaceVariant">#2D2119</item>
        <item name="android:windowBackground">#100B08</item>
        <item name="android:statusBarColor">#100B08</item>
        <item name="android:navigationBarColor">#100B08</item>
    </style>

    <style name="Theme.BaiZe.Amoled" parent="Theme.BaiZe.Base">
        <item name="colorPrimary">#65B3FF</item>
        <item name="colorPrimaryContainer">#092A4A</item>
        <item name="colorSecondary">#70E0D1</item>
        <item name="colorSecondaryContainer">#103632</item>
        <item name="colorTertiary">#A89AFF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#0A0E14</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Theme.BaiZe.Monet" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/Widget.BaiZe.GlassCard</item>
        <item name="materialButtonStyle">@style/Widget.BaiZe.Button</item>
    </style>

    <style name="Widget.BaiZe.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">0.6dp</item>
    </style>

    <style name="Widget.BaiZe.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Material3.Button.FilledTonalButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.BaiZe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.BaiZe.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">25sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.BaiZe.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.BaiZe.Nav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.BaiZe.Nav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
